# Server-only local AI configuration. No API key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# Optional PostgreSQL; leave blank to use SQLite.
DATABASE_URL=
DATABASE_SCHEMA=houstonem_demo
# Enables test/test and admin/admin only for the houstonem_demo schema.
DATABASE_SEED_DEMO=0
